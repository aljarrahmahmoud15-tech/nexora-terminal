# Public endpoint; keep HTTPS in production.
NEXORA_HEARTBEAT_URL=https://nexora-terminal-control.onrender.com/api/terminal/heartbeat

# Must match the active key id and shared secret configured on NEXORA.
NEXORA_KEY_ID=nexora-linux-bridge-prod
NEXORA_DEVICE_ID=linux-router-agent
NEXORA_VERSION=1.0.0
NEXORA_REGION=

# The agent sends one heartbeat immediately and then at this interval.
NEXORA_INTERVAL_SECONDS=120
NEXORA_TIMEOUT_SECONDS=15

# Use true only for an explicitly isolated local HTTP test.
NEXORA_ALLOW_INSECURE_HTTP=false
NEXORA_HMAC_SECRET_FILE=/etc/nexora-linux-agent/secret
