# ── Server ──────────────────────────────────────────
PORT=8787
NODE_ENV=development
# Required in production (exact origin, no trailing slash)
CORS_ORIGIN=

# ── Commands allowlist ──────────────────────────────
COMMANDS_FILE=./commands.json

# ── Admin session (min 32 chars, random) ────────────
CONTROL_API_KEY=replace-with-random-secret-at-least-32-characters

# ── HMAC / Bridge ───────────────────────────────────
HMAC_CLOCK_SKEW_SECONDS=300
HEARTBEAT_STALE_SECONDS=300
NEXORA_KEYS_JSON=[]
NEXORA_BRIDGE_HMAC_SECRET=
NEXORA_JOB_CLOCK_SKEW_SECONDS=60
# single_instance_memory | (leave empty to disable jobs)
NEXORA_BRIDGE_JOBS_MODE=

# ── Optional self-heartbeat ─────────────────────────
NEXORA_SELF_HEARTBEAT_ENABLED=false
NEXORA_SELF_HEARTBEAT_URL=
NEXORA_SELF_HEARTBEAT_DEVICE_ID=local_render
NEXORA_SELF_HEARTBEAT_KEY_ID=nexora-linux-bridge-prod
NEXORA_SELF_HEARTBEAT_VERSION=production
NEXORA_SELF_HEARTBEAT_INTERVAL_SECONDS=120

# ── Render (read-only) ──────────────────────────────
RENDER_API_KEY=

# ── Manus (server-side only) ────────────────────────
MANUS_API_KEY=

# ── Optional GitHub sync ────────────────────────────
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_PATH=backend/commands.json
GITHUB_PRIVATE=true
GIT_USER_NAME=NEXORA
GIT_USER_EMAIL=noreply@nexora.local
GIT_REMOTE_NAME=origin
GIT_BRANCH=main

# ── Future Redis ────────────────────────────────────
# REDIS_URL=redis://redis:6379
